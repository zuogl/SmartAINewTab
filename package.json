{
  "name": "smart-ai-new-tab",
  "version": "0.1.50",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "vite",
    "dev:extension": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "backgrounds:check": "node scripts/check-background-assets.mjs",
    "screenshots:capture": "node scripts/capture-product-shots.mjs",
    "store-assets:generate": "node scripts/generate-store-assets.mjs",
    "cws:package": "node scripts/build-cws-submission.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "public:check": "node scripts/check-public-repo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run public:check && npm run backgrounds:check && npm run notices:check && npm run typecheck && npm run test:run && npm run build",
    "release:local": "node scripts/build-local-extension.mjs",
    "check:worker": "npm --prefix worker run check",
    "check:all": "npm run check && npm run check:worker"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@icons-pack/react-simple-icons": "13.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "dexie": "^4.4.4",
    "fuse.js": "^7.1.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wxt": "^0.21.3"
  }
}
